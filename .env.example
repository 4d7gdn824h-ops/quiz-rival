# Optional. When both are set, rooms persist in Supabase instead of in-memory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Homework scan (vision). If neither is set, extract does NOT treat every upload as Chłopi.
# Use demo worksheets (PL / EN / ES) or paste the page; photos need a key for real vision.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional model overrides:
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TEXT_MODEL=gpt-4o-mini
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
# ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5
