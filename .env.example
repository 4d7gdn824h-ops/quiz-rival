# Optional. When both are set, two-phone rooms persist in Supabase.
# These are public by design (the anon key is not an AI secret).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Homework scan. Server-only. Never prefix with NEXT_PUBLIC_.
# If unset, photos are not sent to a model. Use a demo worksheet or paste the page.
# XAI_API_KEY=
# Optional model override (default grok-4.20-0309-non-reasoning, fast; reasoning models are too slow for a 60 s Vercel function):
# XAI_MODEL=grok-4.20-0309-non-reasoning
