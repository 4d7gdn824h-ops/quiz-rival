# Optional. When both are set, rooms persist in Supabase instead of in-memory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Grok (xAI) is the only AI provider. Chat completions: https://api.x.ai/v1
# If XAI_API_KEY is unset, scans stay in demo/paste mode and the UI says AI is not configured.
# OpenAI and Anthropic keys are not read.
XAI_API_KEY=
# Optional model overrides. Defaults are current xAI ids (text + image input).
# XAI_MODEL=grok-4.6
# XAI_VISION_MODEL=grok-4.6
# Optional. Grok 4.6 reasons by default; low keeps worksheet JSON faster. Use off to omit the field.
# XAI_REASONING_EFFORT=low
